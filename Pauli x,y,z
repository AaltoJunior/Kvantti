import numpy as np
import matplotlib.pyplot as plt
import ipywidgets as widgets
from IPython.display import display, clear_output

# ---------- Bloch sphere ----------
def plot_bloch(ax, v):

    ax.set_title("Bloch-pallo")

    u = np.linspace(0, 2*np.pi, 40)
    v_s = np.linspace(0, np.pi, 40)

    x = np.outer(np.cos(u), np.sin(v_s))
    y = np.outer(np.sin(u), np.sin(v_s))
    z = np.outer(np.ones_like(u), np.cos(v_s))

    ax.plot_wireframe(x, y, z, color="lightgray", alpha=0.3)

    ax.quiver(0, 0, 0, v[0], v[1], v[2],
              color="purple", linewidth=3)

    ax.set_xlim([-1, 1])
    ax.set_ylim([-1, 1])
    ax.set_zlim([-1, 1])

# ---------- enforce only one active axis ----------
def one_hot(x, y, z):

    v = np.array([x, y, z])

    # jos useampi kuin yksi 1 → pidä vain ensimmäinen
    active = np.where(v == 1)[0]

    if len(active) == 0:
        return np.array([0, 0, 0])

    v2 = np.array([0, 0, 0])
    v2[active[0]] = 1

    return v2

# ---------- render ----------
def render(x, y, z):

    clear_output(wait=True)

    v = one_hot(x, y, z)

    fig = plt.figure(figsize=(6, 6))
    ax = fig.add_subplot(111, projection="3d")

    plot_bloch(ax, v)

    plt.show()

    print("Bloch state:")
    print(v)

# ---------- binary sliders ----------
sx = widgets.ToggleButtons(
    options=[0, 1],
    description="X"
)

sy = widgets.ToggleButtons(
    options=[0, 1],
    description="Y"
)

sz = widgets.ToggleButtons(
    options=[0, 1],
    description="Z"
)

ui = widgets.VBox([sx, sy, sz])

out = widgets.interactive_output(render, {
    "x": sx,
    "y": sy,
    "z": sz
})

display(ui, out)
