import numpy as np
import matplotlib.pyplot as plt

from qiskit import QuantumCircuit
from qiskit.quantum_info import Statevector
from qiskit.visualization import (
    plot_histogram,
    plot_bloch_multivector
)
from qiskit_aer import AerSimulator


# =========================
# √2-NÄYTTÖMUOTO
# =========================
def format_sqrt(x):
    if np.isclose(x, 1/np.sqrt(2)):
        return "1/√2"
    elif np.isclose(x, -1/np.sqrt(2)):
        return "-1/√2"
    else:
        return f"{x}"


classic = np.array([
    [0.5, 0.0],
    [0.0, 0.5]
])

quantum = np.array([
    [1/np.sqrt(2), 0],
    [0, 1/np.sqrt(2)]
])


fig, ax = plt.subplots(1, 2, figsize=(10,4))

# ---------------------------------------------------
# Klassinen korrelaatio
# ---------------------------------------------------

ax[0].imshow(np.ones((2,2)), cmap="gray", vmin=0, vmax=1)

ax[0].set_title("Klassinen korrelaatio")

for i in range(2):
    for j in range(2):

        ax[0].text(
            j,
            i,
            f"{classic[i,j]:.1f}",
            ha="center",
            va="center",
            fontsize=16,
            color="black"
        )

# ---------------------------------------------------
# Lomittunut Bellin-tila
# ---------------------------------------------------

ax[1].imshow(np.ones((2,2)), cmap="gray", vmin=0, vmax=1)

ax[1].set_title("Lomittuminen")

for i in range(2):
    for j in range(2):

        ax[1].text(
            j,
            i,
            format_sqrt(quantum[i,j]),
            ha="center",
            va="center",
            fontsize=16,
            color="black"
        )

for a in ax:

    a.set_xticks([0,1])
    a.set_yticks([0,1])

    a.set_xticklabels(["A = 0", "A = 1"])
    a.set_yticklabels(["B = 0", "B = 1"])

plt.tight_layout()
plt.show()

print("""
Klassinen korrelaatio:
- systeemi on joko 00 tai 11
- todennäköisyydet 0.5 ja 0.5

Lomittuminen:
|Φ+> = (|00> + |11>) / √2

1/√2 ≈ 0.71

Todennäköisyys = amplitudi²
(1/√2)^2 = 0.5
""")

